{
    "app-id": "org.pitivi.Pitivi",
    "branch": "master",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "command": "pitivi",
    "finish-args": [
        "--socket=fallback-x11",
        "--share=ipc",
        "--socket=pulseaudio",
        "--socket=wayland",
        "--metadata=X-DConf=migrate-path=/org/pitivi/Pitivi/",
        "--talk-name=org.freedesktop.Notifications",
        "--filesystem=host",
        "--device=dri"
    ],
    "sdk": "org.gnome.Sdk",
    "copy-icon": true,
    "//": "https://github.com/flathub/org.freedesktop.Sdk.Extension.rust-stable/blob/branch/25.08/README.md#with-clang",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm21"
    ],
    "build-options": {
        "build-args": [
            "--share=network"
        ],
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm21/bin",
        "env": {
            "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER": "clang",
            "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS": "-C link-arg=-fuse-ld=/usr/lib/sdk/rust-stable/bin/mold",
            "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER": "clang",
            "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS": "-C link-arg=-fuse-ld=/usr/lib/sdk/rust-stable/bin/mold",
            "FREI0R_PATH": "/app/lib/frei0r-1/",
            "GST_PLUGIN_SYSTEM_PATH": "/app/lib/gstreamer-1.0/",
            "PYTHON": "python3",
            "RUSTFLAGS": "-C link-arg=-fuse-ld=mold"
        },
        "strip": false,
        "no-debuginfo": true
    },
    "modules": [
        "aarch64/python3-ipdb.json",
        "x86_64/python3-ipdb.json",
        "aarch64/python3-pre-commit.json",
        "x86_64/python3-pre-commit.json",
        "aarch64/python3-pylint.json",
        "x86_64/python3-pylint.json",
        "aarch64/python3-matplotlib.json",
        "x86_64/python3-matplotlib.json",
        "aarch64/python3-librosa.json",
        "x86_64/python3-librosa.json",
        "libcanberra/libcanberra.json",
        {
            "name": "gsound",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/gsound.git",
                    "tag": "1.0.3",
                    "commit": "95d36d60cf53e0e7c5d5325e0f1f4fc765a611ae",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "gsound",
                        "stable-only": true
                    }
                }
            ]
        },
        {
            "name": "x264",
            "config-opts": [
                "--enable-shared",
                "--enable-static",
                "--enable-pic",
                "--disable-lavf"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://code.videolan.org/videolan/x264.git",
                    "//": "Just get the latest from https://code.videolan.org/videolan/x264/-/commits/stable/ they don't do tags/snapshots/releases anymore",
                    "commit": "31e19f92f00c7003fa115047ce50978bc98c3a0d"
                }
            ]
        },
        {
            "//": "Needed by frei0r",
            "name": "gavl",
            "rm-configure": true,
            "build-options": {
                "arch": {
                    "x86_64": {
                        "config-opts": [
                            "--with-cpuflags=-msse -msse2"
                        ]
                    }
                }
            },
            "config-opts": [
                "--without-doxygen",
                "--disable-static",
                "--enable-shared",
                "--with-cpuflags=none"
            ],
            "sources": [
                {
                    "type": "archive",
                    "//": "If you need to touch this again, see how an unreleased snapshot is used here: https://github.com/flathub/org.kde.kdenlive/blob/master/org.kde.kdenlive.json",
                    "url": "https://downloads.sourceforge.net/project/gmerlin/gavl/1.4.0/gavl-1.4.0.tar.gz",
                    "mirror-urls": [
                        "http://http.debian.net/debian/pool/main/g/gavl/gavl_1.4.0.orig.tar.gz"
                    ],
                    "sha256": "51aaac41391a915bd9bad07710957424b046410a276e7deaff24a870929d33ce"
                },
                {
                    "type": "patch",
                    "path": "patches/gavl-ubuntu_armel_ftbfs.patch"
                },
                {
                    "type": "patch",
                    "path": "patches/gavl-implicit-declaration-of-memset.patch"
                },
                {
                    "type": "shell",
                    "commands": [
                        "pwd",
                        "cp -p -v /usr/share/automake-*/config.{sub,guess} ."
                    ]
                },
                {
                    "type": "script",
                    "dest-filename": "autogen.sh",
                    "commands": [
                        "autoreconf -vfi"
                    ]
                }
            ]
        },
        {
            "name": "opencv",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DOPENCV_EXTRA_MODULES_PATH=../contrib/modules",
                "-DOPENCV_GENERATE_PKGCONFIG=1",
                "-DWITH_LAPACK=OFF",
                "-DBUILD_PERF_TESTS=OFF",
                "-DBUILD_TESTS=OFF",
                "-DBUILD_opencv_alphamat=OFF",
                "-DBUILD_opencv_aruco=OFF",
                "-DBUILD_opencv_bgsegm=ON",
                "-DBUILD_opencv_bioinspired=OFF",
                "-DBUILD_opencv_ccalib=OFF",
                "-DBUILD_opencv_cnn_3dobj=OFF",
                "-DBUILD_opencv_cudaarithm=OFF",
                "-DBUILD_opencv_cudabgsegm=OFF",
                "-DBUILD_opencv_cudacodec=OFF",
                "-DBUILD_opencv_cudafeatures2d=OFF",
                "-DBUILD_opencv_cudafilters=OFF",
                "-DBUILD_opencv_cudaimgproc=OFF",
                "-DBUILD_opencv_cudalegacy=OFF",
                "-DBUILD_opencv_cudaobjdetect=OFF",
                "-DBUILD_opencv_cudaoptflow=OFF",
                "-DBUILD_opencv_cudastereo=OFF",
                "-DBUILD_opencv_cudawarping=OFF",
                "-DBUILD_opencv_cudev=OFF",
                "-DBUILD_opencv_cvv=OFF",
                "-DBUILD_opencv_datasets=OFF",
                "-DBUILD_opencv_dnn_objdetect=OFF",
                "-DBUILD_opencv_dnns_easily_fooled=OFF",
                "-DBUILD_opencv_dnn_superres=OFF",
                "-DBUILD_opencv_dpm=OFF",
                "-DBUILD_opencv_face=OFF",
                "-DBUILD_opencv_freetype=OFF",
                "-DBUILD_opencv_fuzzy=OFF",
                "-DBUILD_opencv_hdf=OFF",
                "-DBUILD_opencv_hfs=OFF",
                "-DBUILD_opencv_img_hash=OFF",
                "-DBUILD_opencv_intensity_transform=OFF",
                "-DBUILD_opencv_line_descriptor=OFF",
                "-DBUILD_opencv_matlab=OFF",
                "-DBUILD_opencv_optflow=OFF",
                "-DBUILD_opencv_ovis=OFF",
                "-DBUILD_opencv_phase_unwrapping=OFF",
                "-DBUILD_opencv_plot=ON",
                "-DBUILD_opencv_quality=OFF",
                "-DBUILD_opencv_rapid=OFF",
                "-DBUILD_opencv_reg=OFF",
                "-DBUILD_opencv_rgbd=OFF",
                "-DBUILD_opencv_saliency=OFF",
                "-DBUILD_opencv_sfm=OFF",
                "-DBUILD_opencv_shape=OFF",
                "-DBUILD_opencv_stereo=OFF",
                "-DBUILD_opencv_structured_light=OFF",
                "-DBUILD_opencv_superres=OFF",
                "-DBUILD_opencv_surface_matching=OFF",
                "-DBUILD_opencv_text=OFF",
                "-DBUILD_opencv_tracking=ON",
                "-DBUILD_opencv_videostab=OFF",
                "-DBUILD_opencv_viz=OFF",
                "-DBUILD_opencv_xfeatures2d=OFF",
                "-DBUILD_opencv_ximgproc=OFF",
                "-DBUILD_opencv_xobjdetect=OFF",
                "-DBUILD_opencv_xphoto=OFF"
            ],
            "cleanup": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/opencv/opencv/archive/4.8.0.tar.gz",
                    "sha256": "cbf47ecc336d2bff36b0dcd7d6c179a9bb59e805136af6b9670ca944aef889bd"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/opencv/opencv_contrib/archive/4.8.0.tar.gz",
                    "sha256": "b4aef0f25a22edcd7305df830fa926ca304ea9db65de6ccd02f6cfa5f3357dbb",
                    "dest": "contrib"
                },
                {
                    "type": "patch",
                    "path": "patches/opencv-cmake.patch"
                }
            ]
        },
        {
            "name": "frei0r-plugins",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/dyne/frei0r/archive/v3.5.0.tar.gz",
                    "sha256": "41cc8afa4991f5499cea0973be974469dcee377e67dbfbf6ca76e82b2b9bf22e",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 10670,
                        "stable-only": true,
                        "url-template": "https://github.com/dyne/frei0r/archive/v$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "soundtouch",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://codeberg.org/soundtouch/soundtouch/archive/2.4.1.tar.gz",
                    "sha256": "35d404e6e8c2ebd12fb4000da6fadd75c99e37eed2126a04721828c11c0377ec",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 115722,
                        "url-template": "https://codeberg.org/soundtouch/soundtouch/archive/$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "vo-aacenc",
            "sources": [
                {
                    "type": "archive",
                    "//": "Last updated in 2013: https://github.com/mstorsjo/vo-aacenc/tags",
                    "url": "https://github.com/mstorsjo/vo-aacenc/archive/refs/tags/v0.1.3.tar.gz",
                    "sha256": "ae38610405f862237f6c70360c406297cc4222abf82e86722c505ba74b53a97d"
                },
                {
                    "type": "script",
                    "dest-filename": "autogen.sh",
                    "commands": [
                        "autoreconf -fiv"
                    ]
                }
            ]
        },
        {
            "name": "x265",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "build-options": {
                "arch": {
                    "aarch64": {
                        "cxxflags": "-fPIC"
                    }
                }
            },
            "subdir": "source",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/Multicorewareinc/x265/releases/download/4.3/x265_4.3.tar.gz",
                    "sha256": "83c53e4c8bbb8f1e33ed59e10a7d621d1d7801ca853910c3eb41f038b8ffb121",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://raw.githubusercontent.com/Multicorewareinc/x265/refs/heads/master/x265Version.txt",
                        "version-pattern": "releasetag: ([\\d\\.-]*)$",
                        "url-template": "https://github.com/Multicorewareinc/x265/releases/download/$version/x265_$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "ffmpeg",
            "build-options": {
                "cflags": "-fpermissive"
            },
            "config-opts": [
                "--disable-static",
                "--enable-shared",
                "--enable-pic",
                "--disable-avdevice",
                "--disable-swscale",
                "--disable-programs",
                "--disable-ffplay",
                "--disable-ffprobe",
                "--disable-ffmpeg",
                "--disable-encoder=flac",
                "--disable-protocols",
                "--disable-devices",
                "--disable-network",
                "--disable-hwaccels",
                "--disable-dxva2",
                "--disable-vdpau",
                "--disable-filters",
                "--enable-filter=yadif",
                "--disable-doc",
                "--disable-d3d11va",
                "--disable-dxva2",
                "--disable-audiotoolbox",
                "--disable-videotoolbox",
                "--disable-vaapi",
                "--disable-mediacodec",
                "--disable-nvenc",
                "--disable-mmal",
                "--disable-omx",
                "--disable-omx-rpi",
                "--disable-cuda",
                "--disable-cuvid",
                "--disable-libmfx",
                "--disable-libnpp",
                "--disable-iconv",
                "--disable-jni",
                "--disable-v4l2_m2m",
                "--enable-gpl",
                "--enable-optimizations"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/FFmpeg/FFmpeg/archive/refs/tags/n8.0.1.tar.gz",
                    "sha256": "679aa13a19415d5ddab91e580084e3ab20c963c8240001e5cbb955a97bdd81b1",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://git.ffmpeg.org/gitweb/ffmpeg.git/tags",
                        "version-pattern": "<td><a class=\"list name\" href=\"/gitweb/ffmpeg.git/commit/.+\">n(\\d[.\\d]+\\d)</a></td>",
                        "url-template": "https://github.com/FFmpeg/FFmpeg/archive/refs/tags/n$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "fdk-aac",
            "config-opts": [
                "--with-pic",
                "--disable-static",
                "--enable-shared"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/mstorsjo/fdk-aac/archive/refs/tags/v2.0.3.tar.gz",
                    "sha256": "e25671cd96b10bad896aa42ab91a695a9e573395262baed4e4a2ff178d6a3a78"
                }
            ]
        },
        {
            "name": "orc",
            "buildsystem": "meson",
            "config-opts": [
                "-Dhotdoc=disabled",
                "-Dtests=disabled"
            ],
            "sources": [
                {
                    "type": "git",
                    "tag": "0.4.42",
                    "url": "https://gitlab.freedesktop.org/gstreamer/orc.git"
                }
            ]
        },
        {
            "name": "libdv",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "branch": "meson",
                    "url": "https://gitlab.freedesktop.org/gstreamer/meson-ports/libdv.git"
                }
            ]
        },
        {
            "name": "gstreamer",
            "buildsystem": "meson",
            "builddir": true,
            "config-opts": [
                "--libdir=lib",
                "--wrap-mode=nodownload",
                "-Dbad=enabled",
                "-Dbase=enabled",
                "-Ddevtools=enabled",
                "-Ddoc=disabled",
                "-Dges=enabled",
                "-Dgood=enabled",
                "-Dgpl=enabled",
                "-Dgst-devtools:doc=disabled",
                "-Dgst-editing-services:doc=disabled",
                "-Dgst-editing-services:pygi-overrides-dir=/app/lib/python3.13/site-packages/gi/overrides/",
                "-Dgst-libav:doc=disabled",
                "-Dgst-plugins-bad:aom=disabled",
                "-Dgst-plugins-bad:doc=disabled",
                "-Dgst-plugins-bad:frei0r=enabled",
                "-Dgst-plugins-bad:soundtouch=enabled",
                "-Dgst-plugins-bad:va=enabled",
                "-Dgst-plugins-bad:voaacenc=enabled",
                "-Dgst-plugins-bad:x265=enabled",
                "-Dgst-plugins-base:doc=disabled",
                "-Dgst-plugins-base:orc=enabled",
                "-Dgst-plugins-good:doc=disabled",
                "-Dgst-plugins-good:dv=enabled",
                "-Dgst-plugins-ugly:doc=disabled",
                "-Dgst-plugins-ugly:x264=enabled",
                "-Dgst-python:pygi-overrides-dir=/app/lib/python3.13/site-packages/gi/overrides/",
                "-Dgstreamer-vaapi:doc=disabled",
                "-Dintrospection=enabled",
                "-Dlibav=enabled",
                "-Dpython=enabled",
                "-Dugly=enabled"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.freedesktop.org/gstreamer/gstreamer.git",
                    "branch": "main",
                    "disable-submodules": true
                }
            ]
        },
        {
            "name": "pygobject",
            "//": "This is necessary because the version in the runtime no longer support the libpeas that is needed for pitivi",
            "buildsystem": "meson",
            "config-opts": [
                "-Dtests=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/pygobject/3.50/pygobject-3.50.0.tar.xz",
                    "sha256": "8d836e75b5a881d457ee1622cae4a32bcdba28a0ba562193adb3bbb472472212"
                }
            ]
        },
        {
            "name": "libpeas",
            "buildsystem": "meson",
            "config-opts": [
                "--libdir=lib"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/libpeas.git",
                    "tag": "libpeas-1.36.0",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "libpeas",
                        "stable-only": true
                    }
                }
            ]
        },
        {
            "//": "--libdir can be removed when https://github.com/lu-zero/cargo-c/pull/386 is merged and released",
            "name": "gst-plugins-rs",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://crates.io/api/v1/crates/gst-plugin-gtk4/0.15.2/download",
                    "dest-filename": "gst-plugin-gtk4-0.15.2.tar.gz",
                    "sha256": "9d22a27972c25e706b428e78356458446314c70eb31aef07d4a32b843a6dea94"
                },
                "gst-plugin-gtk4-sources.json"
            ],
            "build-options": {
                "env": {
                    "CARGO_HOME": "/run/build/gst-plugins-rs/cargo"
                }
            },
            "build-commands": [
                "cargo cinstall --offline --release --features=wayland,x11glx,x11egl,dmabuf,gtk_v4_14 --library-type=cdylib --prefix=/app --libdir /app/lib"
            ]
        },
        {
            "name": "pitivi",
            "buildsystem": "meson",
            "builddir": true,
            "config-opts": [
                "--libdir=lib"
            ],
            "build-options": {
                "build-args": [
                    "--share=network"
                ]
            },
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/pitivi.git",
                    "branch": "master"
                }
            ]
        }
    ]
}
